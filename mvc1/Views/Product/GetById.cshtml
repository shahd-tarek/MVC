
<div class="card mt-4" style="width: 25rem;">
    <div class="card-body">
        <h5 class="card-title text-primary">@Model.Title</h5>
        <h6 class="card-subtitle mb-2 text-muted">ID: @Model.Id</h6>
        <p class="card-text">
            <strong>Description:</strong> @Model.Description <br />
            <strong>Price:</strong> @Model.Price <br />
            <strong>Available Quantity:</strong> @Model.Count
        </p>
        <hr />
        <a class="btn btn-secondary" href="~/Product/GetAllProduct">Back to List</a>
    </div>
</div>